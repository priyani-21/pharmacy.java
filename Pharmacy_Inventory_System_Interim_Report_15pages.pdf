BT 1 0 0 1 0 155.2 Tm /F5 8 Tf 10.2 TL (insertRec\(node, m\):) Tj T* (    if node == null: return new BSTNode\(m\)) Tj T* (    if key\(m\) < key\(node.medicine\): node.left  = insertRec\(node.left, m\)) Tj T* (    else:                           node.right = insertRec\(node.right, m\)) Tj T* (    return node) Tj T*  T* (searchByName\(name\):                  // key = name.toLowerCase\(\)) Tj T* (    node = root) Tj T* (    while node != null:) Tj T* (        if key == key\(node.medicine\): return node.medicine) Tj T* (        node = \(key < key\(node.medicine\)\) ? node.left : node.right) Tj T* (    return null) Tj T*  T* (inorder\(node, out\):                  // alphabetical order) Tj T* (    if node == null: return) Tj T* (    inorder\(node.left, out\); out.add\(node.medicine\); inorder\(node.right, out\)) Tj T* ET
Q
