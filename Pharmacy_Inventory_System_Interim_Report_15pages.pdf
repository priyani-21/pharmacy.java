BT 1 0 0 1 0 155.2 Tm /F5 8 Tf 10.2 TL (addMedicine\(name, price, stock, expiry\):) Tj T* (    if price <= 0 or stock < 0: return error      // nothing is stored) Tj T* (    id = "M" + nextNumber\(\)                        // M101, M102, ...) Tj T* (    m  = new Medicine\(id, name, price, stock, expiry\)) Tj T* (    medicineMap.put\(id, m\)                        // O\(1\) average) Tj T* (    nameTree.insert\(m\)                            // O\(h\)) Tj T* (    transactions.addTransaction\(ADD, id, stock\)   // O\(1\)) Tj T* (    return "Medicine added: " + id + ...) Tj T*  T* (sellMedicine\(id, qty\):) Tj T* (    m = medicineMap.get\(id\)) Tj T* (    if m == null:           return "Medicine " + id + " not found.") Tj T* (    if qty <= 0 or qty > m.stock: return error    // stock unchanged) Tj T* (    m.setStock\(m.stock - qty\)) Tj T* (    transactions.addTransaction\(SELL, id, qty\)) Tj T* (    return "Sale recorded. Remaining stock: " + m.stock) Tj T* ET
Q
